# Gemini API キー（Google AI Studio: https://aistudio.google.com/app/apikey）
GEMINI_API_KEY=your_gemini_api_key_here

# GAS エンドポイント（変更する場合のみ）
# GAS_URL=https://script.google.com/macros/s/xxxxxxxxxx/exec

# ── Surge.sh 公開（scripts/deploy-to-surge.js）────────────────────
SURGE_DOMAIN=your-subdomain.surge.sh
SURGE_LOGIN=you@example.com
SURGE_TOKEN=your_surge_token_here

# ── スクリーンショット（scripts/take-screenshot.js）────────────────
# フル URL を指定するか、SURGE_DOMAIN があれば /health-status.html を連結
SCREENSHOT_URL=https://your-subdomain.surge.sh/health-status.html
SCREENSHOT_PATH=/tmp/health-dashboard.png

# ── Slack（scripts/post-to-slack.js）──────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_CHANNEL=general
DASHBOARD_URL=https://your-subdomain.surge.sh/health-status.html
SLACK_TITLE=心身健康ダッシュボード
