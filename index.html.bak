<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>健康・メンタル管理ダッシュボード</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js バージョン固定 (エンジニアレビュー反映) -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50:  '#f0f7ff',
              100: '#e0efff',
              200: '#b9daff',
              300: '#7cbdff',
              400: '#369afc',
              500: '#0b7dee',
              600: '#0060cc',
              700: '#004fa6',
              800: '#054489',
              900: '#0a3a72',
            },
          },
          fontFamily: {
            sans: ['"Inter"', '"Noto Sans JP"', 'sans-serif'],
          },
        },
      },
    };
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <!-- fonts.gstatic.com への preconnect 追加 (エンジニアレビュー反映) -->
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet" />
  <style>
    /* Tailwind fontFamily と競合しないよう body には font-family を指定しない */
    .card-hover { transition: transform 0.2s ease, box-shadow 0.2s ease; }
    .card-hover:hover { transform: translateY(-2px); box-shadow: 0 8px 30px rgba(11,125,238,0.12); }
    .gradient-bar { background: linear-gradient(90deg, #0b7dee 0%, #369afc 100%); }
    .mood-emoji { font-size: 2.5rem; line-height: 1; }
    .chart-container { position: relative; height: 220px; }
    @media (min-width: 768px) { .chart-container { height: 260px; } }
    .tag-chip {
      display: inline-block;
      padding: 2px 10px;
      border-radius: 9999px;
      font-size: 0.72rem;
      font-weight: 500;
    }
    .scroll-area { max-height: 320px; overflow-y: auto; }
    .scroll-area::-webkit-scrollbar { width: 4px; }
    .scroll-area::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 2px; }
    .scroll-area::-webkit-scrollbar-thumb { background: #bfdbfe; border-radius: 2px; }
    /* UI/UXレビュー反映: コントラスト強化のための可視ラベル */
    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }
  </style>
</head>
<body class="bg-slate-50 min-h-screen font-sans">

  <!-- h1: スクリーンリーダー向け（アクセシビリティ対応 / エンジニアレビュー反映） -->
  <h1 class="sr-only">健康・メンタル管理ダッシュボード</h1>

  <!-- ===== ヘッダー ===== -->
  <header class="bg-white border-b border-slate-100 sticky top-0 z-30 shadow-sm" role="banner">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 py-3 flex items-center justify-between">
      <div class="flex items-center gap-3" aria-hidden="true">
        <div class="w-8 h-8 rounded-xl gradient-bar flex items-center justify-center shadow">
          <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 016.364 0L12 7.636l1.318-1.318a4.5 4.5 0 116.364 6.364L12 20.364l-7.682-7.682a4.5 4.5 0 010-6.364z"/>
          </svg>
        </div>
        <span class="text-slate-800 font-semibold text-base tracking-tight">健康 &amp; メンタル ダッシュボード</span>
      </div>
      <div class="flex items-center gap-2">
        <time class="text-xs text-slate-500 hidden sm:block" id="today-date" datetime=""></time>
        <!-- aria-label 追加 (エンジニア・UI/UXレビュー反映) -->
        <button class="ml-2 w-8 h-8 rounded-full bg-primary-50 flex items-center justify-center hover:bg-primary-100 transition" aria-label="設定を開く">
          <svg class="w-4 h-4 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-6xl mx-auto px-4 sm:px-6 py-6 space-y-6" role="main">

    <!-- ===== セクション1：今日の概要 ===== -->
    <section aria-labelledby="overview-heading">
      <div class="flex items-center justify-between mb-3">
        <h2 id="overview-heading" class="text-sm font-semibold text-slate-600 uppercase tracking-widest">今日の概要</h2>
        <button class="text-xs text-primary-500 hover:text-primary-600 font-medium flex items-center gap-1 transition" aria-label="体調の記録を追加する">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4"/></svg>
          記録を追加
        </button>
      </div>
      <!-- トータルスコア + 2行×3列 レイアウト -->
      <div class="grid grid-cols-1 lg:grid-cols-4 gap-4" style="grid-template-rows: auto auto;">

        <!-- トータルスコア (左列、2行分) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col items-center justify-center gap-3 lg:row-span-2" aria-label="トータルスコア 74点">
          <p class="text-xs font-medium text-slate-500 uppercase tracking-widest">Total Score</p>
          <div class="relative w-28 h-28" role="img" aria-label="スコア74%のリング">
            <svg class="w-full h-full -rotate-90" viewBox="0 0 100 100" aria-hidden="true">
              <circle cx="50" cy="50" r="42" fill="none" stroke="#f1f5f9" stroke-width="10"/>
              <circle cx="50" cy="50" r="42" fill="none" stroke="#0b7dee" stroke-width="10"
                stroke-dasharray="263.9" stroke-dashoffset="68.6" stroke-linecap="round"/>
            </svg>
            <div class="absolute inset-0 flex flex-col items-center justify-center">
              <span class="text-3xl font-bold text-primary-500 leading-none" aria-hidden="true">74</span>
              <span class="text-xs text-slate-400 mt-1" aria-hidden="true">/ 100</span>
            </div>
          </div>
          <span class="tag-chip bg-emerald-50 text-emerald-700">↑ 先週比 +2</span>
          <p class="text-xs text-slate-500 text-center leading-relaxed">全体的に良好。<br>睡眠の改善が鍵です。</p>
        </article>

        <!-- 気分スコア (行1, 列2) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="気分スコア 良好 7.5点">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">😊</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">気分</p>
                <p class="text-slate-800 font-semibold">良好</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700" aria-label="上昇傾向">↑</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>スコア</span><span class="text-primary-500 font-medium">7.5 / 10</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" aria-label="気分スコア: 75%">
              <div class="h-full rounded-full" style="width:75%;background:linear-gradient(90deg,#0b7dee,#369afc)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">「やる気が出て、集中できた一日」</p>
        </article>

        <!-- 睡眠 (行1, 列3) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="睡眠 6.5時間 質スコア6点">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">🌙</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">睡眠</p>
                <p class="text-slate-800 font-semibold">6.5時間</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-rose-50 text-rose-600" aria-label="目標未達">↓ 目標未達</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>質スコア</span><span class="text-primary-500 font-medium">6 / 10</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="60" aria-valuemin="0" aria-valuemax="100" aria-label="睡眠スコア: 60%">
              <div class="h-full rounded-full" style="width:60%;background:linear-gradient(90deg,#0b7dee,#369afc)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">目標 7.5h に対して不足気味</p>
        </article>

        <!-- 仕事負荷 (行1, 列4) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="仕事負荷 やや高め 7点">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">💼</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">仕事負荷</p>
                <p class="text-slate-800 font-semibold">やや高め</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500" aria-label="変化なし">→ 横ばい</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>負荷スコア</span><span class="text-amber-400 font-medium">7 / 10</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="70" aria-valuemin="0" aria-valuemax="100" aria-label="仕事負荷: 70%">
              <div class="h-full rounded-full" style="width:70%;background:linear-gradient(90deg,#f59e0b,#f97316)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">会議5本・タスク12件処理</p>
        </article>

        <!-- 体重 (行2, 列2) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="体重 68.2kg 目標へ近づく">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">⚖️</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">体重</p>
                <p class="text-slate-800 font-semibold">68.2 kg</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700" aria-label="目標へ近づいている">↓ 目標へ近づく</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>進捗</span><span class="text-primary-500 font-medium">62%</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="62" aria-valuemin="0" aria-valuemax="100" aria-label="目標体重への進捗: 62%">
              <div class="h-full rounded-full" style="width:62%;background:linear-gradient(90deg,#0b7dee,#369afc)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">BMI 22.1 ／ 目標 65.0kg</p>
        </article>

        <!-- 運動 (行2, 列3) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="運動 30分 目標達成">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">🏃</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">運動</p>
                <p class="text-slate-800 font-semibold">30分</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">目標達成 ✓</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>達成率</span><span class="text-primary-500 font-medium">100%</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" aria-label="運動目標達成率: 100%">
              <div class="h-full rounded-full" style="width:100%;background:linear-gradient(90deg,#10b981,#34d399)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">ウォーキング ／ 目標 30分</p>
        </article>

        <!-- AI学習 (行2, 列4) -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 card-hover flex flex-col gap-3" aria-label="AI学習 45分 目標達成">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-2xl" aria-hidden="true">🤖</span>
              <div>
                <p class="text-xs text-slate-500 tracking-wider uppercase">AI 学習</p>
                <p class="text-slate-800 font-semibold">45分</p>
              </div>
            </div>
            <span class="inline-flex items-center text-xs font-semibold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700">目標達成 ✓</span>
          </div>
          <div>
            <div class="flex justify-between text-xs text-slate-500 mb-1">
              <span>達成率</span><span class="text-primary-500 font-medium">75%</span>
            </div>
            <div class="h-1.5 bg-slate-100 rounded-full overflow-hidden" role="progressbar" aria-valuenow="75" aria-valuemin="0" aria-valuemax="100" aria-label="AI学習目標達成率: 75%">
              <div class="h-full rounded-full" style="width:75%;background:linear-gradient(90deg,#8b5cf6,#a78bfa)"></div>
            </div>
          </div>
          <p class="text-slate-500 text-xs">今週 4/5日 ／ 目標 60分</p>
        </article>

      </div>
    </section>

    <!-- ===== セクション2：グラフエリア ===== -->
    <section aria-labelledby="graph-heading">
      <h2 id="graph-heading" class="text-sm font-semibold text-slate-600 uppercase tracking-widest mb-3">グラフ &amp; トレンド</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        <!-- 体重推移グラフ -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-sm font-semibold text-slate-700">体重推移</h3>
              <p class="text-xs text-slate-500 mt-0.5">過去14日間</p>
            </div>
            <div class="flex gap-1" role="group" aria-label="表示期間の切り替え">
              <button id="btn2w" class="text-xs px-2.5 py-1 rounded-lg bg-primary-50 text-primary-600 font-medium" aria-pressed="true">2週</button>
              <button id="btn1m" class="text-xs px-2.5 py-1 rounded-lg text-slate-500 hover:bg-slate-100 font-medium transition" aria-pressed="false">1ヶ月</button>
            </div>
          </div>
          <div class="flex items-center gap-4 mb-3 text-xs text-slate-500" aria-hidden="true">
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#0b7dee"></span>体重 (kg)</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#f59e0b"></span>体脂肪率 (%)</span>
          </div>
          <div class="chart-container">
            <canvas id="weightChart" aria-label="体重・体脂肪率推移グラフ: 過去14日間で体重69.1kgから68.2kgに減少、体脂肪率21.5%から20.9%に減少傾向" role="img"></canvas>
          </div>
        </div>

        <!-- 気分・睡眠・仕事負荷 相関グラフ -->
        <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-sm font-semibold text-slate-700">気分・睡眠・仕事負荷 相関</h3>
              <p class="text-xs text-slate-500 mt-0.5">過去14日間</p>
            </div>
          </div>
          <!-- 色 + テキストで識別 (アクセシビリティ対応) -->
          <div class="flex items-center gap-4 mb-3 text-xs text-slate-500" aria-hidden="true">
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#0b7dee"></span>気分</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block" style="background:#6366f1"></span>睡眠</span>
            <span class="flex items-center gap-1"><span class="w-2.5 h-2.5 rounded-full inline-block border-2 border-rose-400" style="background:#fff"></span>仕事負荷</span>
          </div>
          <div class="chart-container">
            <canvas id="moodWorkChart" aria-label="気分・睡眠・仕事負荷の相関グラフ: 仕事負荷が高い日ほど気分スコアが低下する傾向" role="img"></canvas>
          </div>
        </div>

      </div>

      <!-- 週別サマリーバー (UI/UXレビュー反映: モバイル向け横スクロール) -->
      <div class="mt-4 bg-white rounded-2xl p-5 shadow-sm border border-slate-100">
        <h3 class="text-sm font-semibold text-slate-700 mb-4">今週の気分スコア推移</h3>
        <div class="overflow-x-auto pb-1" role="list" aria-label="今週の気分スコア一覧">
          <div class="flex gap-4 min-w-max mx-auto justify-center">
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">月</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="月曜日: 8.0">
                <div class="gradient-bar rounded-full w-full" style="height:80%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">8.0</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">火</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="火曜日: 6.5">
                <div class="gradient-bar rounded-full w-full" style="height:65%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">6.5</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">水</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="水曜日: 9.0">
                <div class="gradient-bar rounded-full w-full" style="height:90%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">9.0</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">木</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="木曜日: 7.0">
                <div class="gradient-bar rounded-full w-full" style="height:70%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">7.0</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">金</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="金曜日: 5.5">
                <div class="gradient-bar rounded-full w-full" style="height:55%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">5.5</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-slate-500">土</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse" style="height:60px" title="土曜日: 4.0">
                <div class="gradient-bar rounded-full w-full" style="height:40%"></div>
              </div>
              <p class="text-xs font-semibold text-slate-600">4.0</p>
            </div>
            <div class="flex flex-col items-center gap-2 w-10" role="listitem">
              <p class="text-xs text-primary-600 font-bold">今日</p>
              <div class="w-6 bg-slate-100 rounded-full overflow-hidden flex flex-col-reverse border-2 border-primary-400" style="height:60px" title="今日: 8.0">
                <div class="gradient-bar rounded-full w-full" style="height:80%"></div>
              </div>
              <p class="text-xs font-bold text-primary-600">8.0</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== セクション3：記録 ===== -->
    <section aria-labelledby="diary-heading">
      <div class="flex items-center justify-between mb-3">
        <h2 id="diary-heading" class="text-sm font-semibold text-slate-700 flex items-center gap-2">
          <span class="inline-block w-0.5 h-4 rounded bg-primary-500" aria-hidden="true"></span>
          記録
        </h2>
        <a href="#" class="text-primary-500 text-xs hover:underline transition">すべて見る →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">

        <!-- Good & New -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-4" aria-labelledby="gn-heading">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg" aria-hidden="true">✨</span>
              <h3 id="gn-heading" class="text-sm font-semibold text-slate-700">Good &amp; New</h3>
            </div>
            <span class="tag-chip bg-slate-100 text-slate-500">毎日</span>
          </div>

          <!-- インライン追加フォーム (初期非表示) -->
          <div id="gnForm" class="hidden flex gap-2" role="form" aria-label="Good and New を追加">
            <label for="gnInput" class="sr-only">今日の Good or New を入力</label>
            <input
              id="gnInput"
              type="text"
              placeholder="今日の Good or New を書く..."
              class="flex-1 text-sm border border-slate-200 rounded-xl px-3 py-2 outline-none focus:border-primary-400 focus:ring-2 focus:ring-primary-100 transition placeholder-slate-400"
              maxlength="200"
            />
            <button id="gnSubmit" type="button" class="px-3 py-2 rounded-xl gradient-bar text-white text-xs font-medium hover:opacity-90 transition shadow-sm">追加</button>
          </div>

          <ul class="flex flex-col gap-3" id="gnList" role="list" aria-label="Good and New の記録一覧">
            <li class="flex gap-3" role="listitem">
              <span class="text-primary-500 mt-0.5 text-sm font-bold shrink-0" aria-hidden="true">→</span>
              <div>
                <p class="text-slate-600 text-sm leading-relaxed">朝のウォーキング中に近所の桜がまだ少し残っているのを発見した</p>
                <p class="text-slate-400 text-xs mt-0.5">Good</p>
              </div>
            </li>
            <li class="flex gap-3" role="listitem">
              <span class="text-primary-500 mt-0.5 text-sm font-bold shrink-0" aria-hidden="true">→</span>
              <div>
                <p class="text-slate-600 text-sm leading-relaxed">新しいコーヒーショップを見つけ、豆の話を店員さんと30分話した</p>
                <p class="text-slate-400 text-xs mt-0.5">New</p>
              </div>
            </li>
            <li class="flex gap-3" role="listitem">
              <span class="text-primary-500 mt-0.5 text-sm font-bold shrink-0" aria-hidden="true">→</span>
              <div>
                <p class="text-slate-600 text-sm leading-relaxed">チームのプレゼンがうまくいき、クライアントから好評を得た</p>
                <p class="text-slate-400 text-xs mt-0.5">Good</p>
              </div>
            </li>
          </ul>

          <button type="button" id="gnAddBtn" class="mt-auto w-full py-2.5 rounded-xl text-xs text-primary-500 border border-primary-100 hover:bg-primary-50 transition">
            + 今日の Good &amp; New を追加
          </button>
        </article>

        <!-- 感謝日記 -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-4" aria-labelledby="gratitude-heading">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg" aria-hidden="true">🙏</span>
              <h3 id="gratitude-heading" class="text-sm font-semibold text-slate-700">感謝日記</h3>
            </div>
            <span class="tag-chip bg-slate-100 text-slate-500">3 / 3件</span>
          </div>
          <ul class="flex flex-col gap-3">
            <li class="flex gap-3">
              <span class="text-primary-500 text-sm mt-0.5 shrink-0" aria-hidden="true">♡</span>
              <p class="text-slate-600 text-sm leading-relaxed">忙しいのにランチに誘ってくれた同僚の田中さんに感謝</p>
            </li>
            <li class="flex gap-3">
              <span class="text-primary-500 text-sm mt-0.5 shrink-0" aria-hidden="true">♡</span>
              <p class="text-slate-600 text-sm leading-relaxed">健康な体で毎朝起きられることへの感謝</p>
            </li>
            <li class="flex gap-3">
              <span class="text-primary-500 text-sm mt-0.5 shrink-0" aria-hidden="true">♡</span>
              <p class="text-slate-600 text-sm leading-relaxed">締め切りに間に合わせられた自分の集中力に感謝</p>
            </li>
          </ul>
          <div class="mt-auto pt-3 border-t border-slate-100">
            <p class="text-slate-500 text-xs">7日間継続中 🔥 &nbsp;記録率 <span class="text-primary-500 font-medium">91%</span></p>
          </div>
        </article>

        <!-- 予定リスト -->
        <article class="bg-white rounded-2xl p-5 shadow-sm border border-slate-100 flex flex-col gap-4" aria-labelledby="todo-heading">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="text-lg" aria-hidden="true">📋</span>
              <h3 id="todo-heading" class="text-sm font-semibold text-slate-700">予定リスト</h3>
            </div>
            <span class="tag-chip bg-primary-50 text-primary-700">今日</span>
          </div>
          <ul class="flex flex-col gap-2.5" id="todoList" role="list" aria-label="今日の予定一覧">
            <li class="flex items-start gap-3" role="listitem">
              <button type="button" class="todo-toggle mt-0.5 w-4 h-4 rounded border-2 border-primary-400 bg-primary-50 flex items-center justify-center shrink-0 transition" aria-pressed="true" aria-label="完了済み">
                <svg class="w-2.5 h-2.5 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-400 line-through leading-snug">朝のウォーキング 30分</p>
                <p class="text-xs text-slate-400 mt-0.5">08:00 · 健康</p>
              </div>
            </li>
            <li class="flex items-start gap-3" role="listitem">
              <button type="button" class="todo-toggle mt-0.5 w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center shrink-0 transition hover:border-primary-400" aria-pressed="false" aria-label="未完了">
                <svg class="w-2.5 h-2.5 text-transparent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-700 leading-snug">チームミーティング</p>
                <p class="text-xs text-slate-400 mt-0.5">10:00 · 仕事</p>
              </div>
            </li>
            <li class="flex items-start gap-3" role="listitem">
              <button type="button" class="todo-toggle mt-0.5 w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center shrink-0 transition hover:border-primary-400" aria-pressed="false" aria-label="未完了">
                <svg class="w-2.5 h-2.5 text-transparent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-700 leading-snug">AI学習 — LLMファインチューニング</p>
                <p class="text-xs text-slate-400 mt-0.5">13:00 · 学習</p>
              </div>
            </li>
            <li class="flex items-start gap-3" role="listitem">
              <button type="button" class="todo-toggle mt-0.5 w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center shrink-0 transition hover:border-primary-400" aria-pressed="false" aria-label="未完了">
                <svg class="w-2.5 h-2.5 text-transparent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-700 leading-snug">週次レポート提出</p>
                <p class="text-xs text-rose-400 mt-0.5">17:00 · 締め切り</p>
              </div>
            </li>
            <li class="flex items-start gap-3" role="listitem">
              <button type="button" class="todo-toggle mt-0.5 w-4 h-4 rounded border-2 border-slate-300 flex items-center justify-center shrink-0 transition hover:border-primary-400" aria-pressed="false" aria-label="未完了">
                <svg class="w-2.5 h-2.5 text-transparent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </button>
              <div class="flex-1 min-w-0">
                <p class="text-sm text-slate-700 leading-snug">就寝前ストレッチ</p>
                <p class="text-xs text-slate-400 mt-0.5">22:00 · 健康</p>
              </div>
            </li>
          </ul>
          <button type="button" class="mt-auto w-full py-2.5 rounded-xl text-xs text-primary-500 border border-primary-100 hover:bg-primary-50 transition">
            + 予定を追加
          </button>
        </article>

      </div>
    </section>

    <!-- ===== フッター ===== -->
    <footer class="text-center text-xs text-slate-400 pb-4 pt-2" role="contentinfo">
      健康 &amp; メンタル管理ダッシュボード · 2026
    </footer>

  </main>

  <!-- ===== JavaScript ===== -->
  <script>
    // 今日の日付 (time 要素にも datetime を設定)
    const dateEl = document.getElementById('today-date');
    if (dateEl) {
      const now = new Date();
      const iso = now.toISOString().split('T')[0];
      dateEl.setAttribute('datetime', iso);
      dateEl.textContent = now.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric', weekday: 'short' });
    }

    // --- Chart.js グラフ設定 ---
    // グローバルデフォルトを変更せず、インスタンス options に記述 (エンジニアレビュー反映)
    const chartFont = { family: "'Inter', 'Noto Sans JP', sans-serif", size: 12 };
    const chartColor = '#64748b'; // slate-500 相当 (コントラスト改善)

    const tooltipDefaults = {
      backgroundColor: '#1e293b',
      titleColor: '#94a3b8',
      bodyColor: '#f1f5f9',
      padding: 10,
      cornerRadius: 8,
    };

    const labels14 = ['3/29','3/30','3/31','4/1','4/2','4/3','4/4','4/5','4/6','4/7','4/8','4/9','4/10','4/11'];

    // 体重推移グラフ (体脂肪率を右軸で追加)
    const weightChart = new Chart(document.getElementById('weightChart'), {
      type: 'line',
      data: {
        labels: labels14,
        datasets: [
          {
            label: '体重 (kg)',
            data: [69.1, 68.9, 68.7, 68.8, 68.6, 68.5, 68.7, 68.4, 68.6, 68.5, 68.3, 68.4, 68.5, 68.2],
            borderColor: '#0b7dee',
            backgroundColor: 'rgba(11,125,238,0.08)',
            borderWidth: 2.5,
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#0b7dee',
            pointBorderWidth: 2,
            fill: true,
            tension: 0.4,
            yAxisID: 'yWeight',
          },
          {
            label: '体脂肪率 (%)',
            data: [21.5, 21.4, 21.3, 21.4, 21.2, 21.1, 21.3, 21.1, 21.2, 21.0, 21.0, 21.1, 21.0, 20.9],
            borderColor: '#f59e0b',
            backgroundColor: 'rgba(245,158,11,0.06)',
            borderWidth: 2,
            borderDash: [4, 3],
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#f59e0b',
            pointBorderWidth: 2,
            fill: false,
            tension: 0.4,
            yAxisID: 'yFat',
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            ...tooltipDefaults,
            callbacks: {
              label: ctx => ctx.dataset.yAxisID === 'yWeight'
                ? ` 体重: ${ctx.parsed.y} kg`
                : ` 体脂肪率: ${ctx.parsed.y} %`,
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { maxTicksLimit: 7, font: chartFont, color: chartColor },
          },
          yWeight: {
            type: 'linear',
            position: 'left',
            grid: { color: '#f1f5f9' },
            ticks: { callback: v => v + 'kg', stepSize: 0.5, font: chartFont, color: '#0b7dee' },
            min: 67.5,
            max: 69.5,
          },
          yFat: {
            type: 'linear',
            position: 'right',
            grid: { drawOnChartArea: false },
            ticks: { callback: v => v + '%', stepSize: 0.5, font: chartFont, color: '#f59e0b' },
            min: 19.5,
            max: 22.5,
          },
        },
      },
    });

    // 気分・睡眠・仕事負荷 相関グラフ
    const moodWorkChart = new Chart(document.getElementById('moodWorkChart'), {
      type: 'line',
      data: {
        labels: labels14,
        datasets: [
          {
            label: '気分',
            data: [8, 7.5, 8, 7, 6.5, 8, 9, 7, 6, 7.5, 8, 7, 8, 7.5],
            borderColor: '#0b7dee',
            backgroundColor: 'rgba(11,125,238,0.06)',
            borderWidth: 2,
            borderDash: [],
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#0b7dee',
            pointBorderWidth: 2,
            fill: false,
            tension: 0.4,
          },
          {
            label: '睡眠',
            data: [7, 6.5, 7.5, 6, 7, 8, 7.5, 6.5, 6, 7, 7.5, 6.5, 7, 7],
            borderColor: '#6366f1',
            backgroundColor: 'rgba(99,102,241,0.06)',
            borderWidth: 2,
            borderDash: [3, 2],
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#6366f1',
            pointBorderWidth: 2,
            pointStyle: 'triangle',
            fill: false,
            tension: 0.4,
          },
          {
            label: '仕事負荷',
            data: [5, 6, 7, 8, 9, 7, 5, 6, 9, 8, 7, 6, 7, 8],
            borderColor: '#f43f5e',
            backgroundColor: 'rgba(244,63,94,0.06)',
            borderWidth: 2,
            borderDash: [5, 3],
            pointRadius: 3,
            pointHoverRadius: 5,
            pointBackgroundColor: '#fff',
            pointBorderColor: '#f43f5e',
            pointBorderWidth: 2,
            pointStyle: 'rectRot',
            fill: false,
            tension: 0.4,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            ...tooltipDefaults,
            callbacks: {
              label: ctx => ` ${ctx.dataset.label}: ${ctx.parsed.y}`,
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { maxTicksLimit: 7, font: chartFont, color: chartColor },
          },
          y: {
            grid: { color: '#f1f5f9' },
            min: 0,
            max: 10,
            ticks: { stepSize: 2, font: chartFont, color: chartColor },
          },
        },
      },
    });

    // --- Good & New: ボタンでフォームをトグル表示 ---
    const gnAddBtn  = document.getElementById('gnAddBtn');
    const gnForm    = document.getElementById('gnForm');
    const gnInput   = document.getElementById('gnInput');
    const gnSubmit  = document.getElementById('gnSubmit');

    gnAddBtn.addEventListener('click', () => {
      const isHidden = gnForm.classList.contains('hidden');
      gnForm.classList.toggle('hidden', !isHidden);
      gnForm.classList.toggle('flex', isHidden);
      if (isHidden) gnInput.focus();
    });

    function addGoodNew() {
      const rawText = gnInput.value.trim();
      if (!rawText) return;
      const list = document.getElementById('gnList');

      const li = document.createElement('li');
      li.className = 'flex gap-3';
      li.setAttribute('role', 'listitem');

      const arrow = document.createElement('span');
      arrow.className = 'text-primary-500 mt-0.5 text-sm font-bold shrink-0';
      arrow.setAttribute('aria-hidden', 'true');
      arrow.textContent = '→';

      const inner = document.createElement('div');

      const textP = document.createElement('p');
      textP.className = 'text-slate-600 text-sm leading-relaxed';
      textP.textContent = rawText;

      const metaP = document.createElement('p');
      metaP.className = 'text-slate-400 text-xs mt-0.5';
      metaP.textContent = 'Good';

      inner.appendChild(textP);
      inner.appendChild(metaP);
      li.appendChild(arrow);
      li.appendChild(inner);
      list.prepend(li);

      gnInput.value = '';
      gnForm.classList.add('hidden');
      gnForm.classList.remove('flex');
    }

    gnSubmit.addEventListener('click', addGoodNew);
    gnInput.addEventListener('keydown', e => { if (e.key === 'Enter') addGoodNew(); });

    // --- 予定リスト: チェックボックストグル ---
    document.getElementById('todoList').addEventListener('click', e => {
      const btn = e.target.closest('.todo-toggle');
      if (!btn) return;
      const isDone = btn.getAttribute('aria-pressed') === 'true';
      const newDone = !isDone;
      btn.setAttribute('aria-pressed', String(newDone));

      const svg = btn.querySelector('svg');
      const textEl = btn.closest('li').querySelector('p.text-sm');

      if (newDone) {
        btn.classList.replace('border-slate-300', 'border-primary-400');
        btn.classList.add('bg-primary-50');
        svg.classList.replace('text-transparent', 'text-primary-500');
        textEl.classList.add('line-through', 'text-slate-400');
        textEl.classList.remove('text-slate-700');
      } else {
        btn.classList.replace('border-primary-400', 'border-slate-300');
        btn.classList.remove('bg-primary-50');
        svg.classList.replace('text-primary-500', 'text-transparent');
        textEl.classList.remove('line-through', 'text-slate-400');
        textEl.classList.add('text-slate-700');
      }
    });

    // --- 期間切り替えトグル (aria-pressed 対応 / UI/UXレビュー反映) ---
    const btn2w = document.getElementById('btn2w');
    const btn1m = document.getElementById('btn1m');

    function setActiveBtn(active, inactive) {
      active.classList.add('bg-primary-50', 'text-primary-600');
      active.classList.remove('text-slate-500', 'hover:bg-slate-100');
      active.setAttribute('aria-pressed', 'true');
      inactive.classList.remove('bg-primary-50', 'text-primary-600');
      inactive.classList.add('text-slate-500', 'hover:bg-slate-100');
      inactive.setAttribute('aria-pressed', 'false');
    }

    btn2w.addEventListener('click', () => setActiveBtn(btn2w, btn1m));
    btn1m.addEventListener('click', () => setActiveBtn(btn1m, btn2w));
  </script>
</body>
</html>
